node_modules/
src-tauri/target/
src-tauri/gen/
# Staged by scripts/bundle-runtime.mjs: the Node runtime and dsh the installer
# ships. The directory itself is tracked so the bundler's glob always matches —
# a build without a staged runtime falls back to `dsh` on PATH.
src-tauri/resources/*
!src-tauri/resources/.gitkeep
# Not staged: source, which happens to live where the resources go so that one
# path serves both a bundled build and `tauri dev`. See src-tauri/src/plugins.rs.
!src-tauri/resources/preset-plugins.json
bash.exe.stackdump
