{
  // Deploys `worker.js` onto two hostnames:
  //
  //   dsh-desktop.cc.cd/updater/*   the update feed, and nothing else
  //   dl.dsh-desktop.cc.cd/*        the installer bytes
  //
  // The split exists because Google's Safe Browsing report kept saying the
  // marketing site "hosts" the installers — with no sample URL — and removing
  // the links from the pages changed nothing while `/updater/download/...`
  // kept answering 200 with an `.exe`. See the top of worker.js.
  //
  // ⚠️ The `dl` DNS record must exist before this is deployed: Cloudflare
  // dashboard → the dsh-desktop.cc.cd zone → DNS → add a proxied A record named
  // `dl` (192.0.2.1 is the usual placeholder; the Worker route catches the
  // request before that address is ever dialled). Without it the feed points at
  // a hostname that does not resolve, and every update fails.
  //
  // Deploy order that does not break installed copies:
  //   1. add the `dl` DNS record (it can 404 until step 2);
  //   2. `npx wrangler deploy`;
  //   3. check https://dl.dsh-desktop.cc.cd/v<latest>/<asset> returns 200;
  //   4. check /updater/latest.json names dl.*, and /updater/download/...
  //      returns 410.
  //
  // `DOWNLOAD_ORIGIN` is where the feed sends clients. Set it to "" to stop
  // proxying bytes entirely: the feed then names GitHub, and users who cannot
  // reach GitHub lose auto-update (but the marketing host is clean either way).
  "name": "dsh-desktop-updater",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "routes": [
    {
      "pattern": "dsh-desktop.cc.cd/updater/*",
      "zone_name": "dsh-desktop.cc.cd"
    },
    {
      "pattern": "dl.dsh-desktop.cc.cd/*",
      "zone_name": "dsh-desktop.cc.cd"
    }
  ],
  "vars": {
    "DOWNLOAD_ORIGIN": "https://dl.dsh-desktop.cc.cd"
  },
  "observability": { "enabled": true }
}
